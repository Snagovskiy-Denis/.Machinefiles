# [Created by task 2.5.3 5/21/2021 13:59:10]
# Taskwarrior program configuration file.
# For more documentation, see http://taskwarrior.org or try 'man task', 'man task-color',
# 'man task-sync' or 'man taskrc'

# Here is an example of entries that use the default, override and blank values
#   variable=foo   -- By specifying a value, this overrides the default
#   variable=      -- By specifying no value, this means no default
#   #variable=foo  -- By commenting out the line, or deleting it, this uses the default

# Use the command 'task show' to see all defaults and overrides

verbose=blank,footnote,label,new-id,affected,edit,special,project,sync,unwait

data.location=~/.config/.task
weekstart=Monday

include ./theme

# 
# scrum setup uses context
# its rules:
# - context t --> what I execute today
# - context w --> what belongs to the current sprint
# - anything without scheduled or dues inside the next w --> backlog
# 

# context
context.t.read=scheduled < tomorrow or due < tomorrow
context.t.write=scheduled:today

# w (planning horizon = sprint)
context.w.read=scheduled < 1week or due < 1week
context.w.write=scheduled:6days


# UDA stands for User Defined Arguments
## Esimate — how much time will task occupy
uda.estimate.label=⏳
uda.estimate.type=duration

uda.resistance.label=👿
uda.resistance.type=string
uda.resistance.values=gremlin,demon,treshold

# report
# report.next.columns = id,start.age,entry.age,depends,priority,project,tags,recur,scheduled.countdown,due.relative,until.remaining,description.count,urgency
report.next.labels=ID,Age,P,Sched,⏳,Description,Due,Project,👿,Tag,Urg
report.next.columns=id,entry.age,priority,scheduled.countdown,estimate,description,due.relative,project,resistance,tags,urgency
# use description.count to replace annotations with annotations count
report.next.sort=urgency-
report.next.filter=status:pending -WAITING limit:page

report.waiting.columns=id,start.active,entry.age,depends.indicator,priority,project,tags,recur.indicator,wait,wait.remaining,scheduled,due,until,estimate,description
report.waiting.labels=ID,A,Age,D,P,Project,Tags,R,Wait,Remaining,Sched,Due,Until,Estimate,Description

report.retro.labels=UUID,Done,Project,👿,Tags,R,Description
report.retro.description=Completed tasks for last week
report.retro.columns=uuid.short,end,project,resistance,tags,recur.indicator,description
report.retro.sort=project-/,end+
report.retro.filter=status:completed end > today-1w

# Urgency coefficients
#   Due + scheduled + High priority = Top Urgency
#   Current project = Middle Urgency
#   Time Estimate matches my free time = Low Urgency
#   No priority, no estimate, no difficulty, etc. = is this even a task? should I keep it?
# examples:
# urgency.user.tag.mytag.coefficient=0
# urgency.user.project.myproject.coefficient=0
urgency.uda.estimate..coefficient=-1.5  # no estimate = hard to plan
urgency.uda.priority.L.coefficient=-3
urgency.blocking.coefficient=0
urgency.blocked.coefficient=-3
urgency.annotations.coefficient=0
urgency.user.tag.retro.coefficient=0.3
urgency.user.project..coefficient=-1
urgency.user.tag.red.coefficient=0.2

# Priority goals
urgency.user.project.LVLUP2.coefficient=0.5
urgency.user.project.WORLDWIDE.coefficient=2

# plugins
## taskwarrior-tui
uda.taskwarrior-tui.task-report.next.filter=status:pending
uda.taskwarrior-tui.shortcuts.2=/usr/bin/taskopen note
uda.taskwarrior-tui.shortcuts.3=/usr/bin/taskopen url
uda.taskwarrior-tui.shortcuts.1=/usr/bin/taskopen

## taskopen
alias.open=execute taskopen
alias.addnote=execute /usr/share/taskopen/scripts/addnote  # usage: task addnote 127 && taskopen 127
alias.editnote=execute "$HOME/.local/bin/editnote"  # usage: task editnote 127


# End of file
# Below are 'task config'-setted values
context=t
